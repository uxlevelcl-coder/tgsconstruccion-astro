{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tgsconstruccion-astro",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "tgsconstruccion.cl/*", "zone_name": "tgsconstruccion.cl" },
    { "pattern": "www.tgsconstruccion.cl/*", "zone_name": "tgsconstruccion.cl" }
  ]
}
