---
import site from '../data/site.json';
const ruta = Astro.url.pathname;
const activo = (u) => u === '/' ? ruta === '/' : ruta.startsWith(u);
---
<script is:inline>
  if (window.scrollY < 24) document.documentElement.classList.add('at-top');
</script>
<!-- nav flotante -->
<div class="hdwrap">
  <div class="wrap">
    <header class="hd">
      <div class="hd__in">
        <a href="/" class="hd__logo" aria-label="TGS Construcción, ir al inicio">
          <img class="logo-oscuro" src="/img/logo-tgs.svg" alt="TGS Construcción" width="155" height="40" />
          <img class="logo-claro" src="/img/logo-tgs-blanco.svg" alt="" aria-hidden="true" width="155" height="40" />
        </a>

        <nav class="hd__nav" aria-label="Navegación principal">
          {site.nav.map(item => item.sub ? (
            <div class="hd__drop">
              <a href={item.url} class:list={{ 'is-active': ruta.startsWith('/remodelacion') || ruta.startsWith('/construccion') }}>
                {item.label}
                <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true">
                  <path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </a>
              <div class="hd__menu">
                {item.sub.map(s => <a href={s.url} class:list={{ 'is-active': ruta === s.url }}>{s.label}</a>)}
              </div>
            </div>
          ) : (
            <a href={item.url} class:list={{ 'is-active': activo(item.url) }}>{item.label}</a>
          ))}
        </nav>

        <div class="hd__side">
          <a href={`https://wa.me/${site.empresa.whatsapp}?text=${encodeURIComponent('Hola, quiero un presupuesto de remodelación.')}`}
             class="hd__tel" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.2-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.1.2-.3.2-.6.1-.3-.1-1.1-.4-2.1-1.3-.8-.7-1.3-1.5-1.4-1.8-.1-.3 0-.4.1-.6.1-.1.3-.4.5-.6.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.6-1.5-.8-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.6.6.2 1.2.2 1.6.1.5-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.3-.2-.6-.4z"/>
              <path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.3c1.4.8 3 1.3 4.7 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3C4.2 15 3.8 13.5 3.8 12 3.8 7.5 7.5 3.8 12 3.8S20.2 7.5 20.2 12 16.5 20.2 12 20.2z"/>
            </svg>
            <span>{site.empresa.telefono}</span>
          </a>
          <a href="/contacto/" class="btn btn--dark hd__cta">Contacto</a>
          <button class="hd__burger" id="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mnav">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>
  </div>
</div>

<nav class="mnav" id="mnav" aria-label="Menú móvil">
  <div class="mnav__in">
    {site.nav.map(item => item.sub ? (
      <div class="mnav__group">
        <span class="mnav__label">{item.label}</span>
        {item.sub.map(s => <a href={s.url} class="mnav__sub">{s.label}</a>)}
      </div>
    ) : (
      <a href={item.url} class="mnav__link">{item.label}</a>
    ))}
  </div>
  <div class="mnav__foot">
    <a href="/contacto/" class="btn btn--dark" style="width:100%">Contacto</a>
    <a href={`https://wa.me/${site.empresa.whatsapp}`} class="mnav__wa">WhatsApp {site.empresa.telefono}</a>
    <span class="mnav__meta">{site.empresa.email}</span>
    <span class="mnav__meta">{site.empresa.horario}</span>
  </div>
</nav>

<script>
  (() => {
    const marcarArriba = () => document.documentElement.classList.toggle('at-top', window.scrollY < 24);
    marcarArriba();
    window.addEventListener('scroll', marcarArriba, { passive: true });
    window.addEventListener('resize', marcarArriba);
  })();

  (() => {
    const burger = document.getElementById('burger');
    const mnav = document.getElementById('mnav');
    if (!burger || !mnav) return;
    const setOpen = (open) => {
      mnav.classList.toggle('open', open);
      document.body.classList.toggle('nav-open', open);
      burger.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
    };
    burger.addEventListener('click', (e) => { e.stopPropagation(); setOpen(!mnav.classList.contains('open')); });
    mnav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    window.addEventListener('resize', () => { if (window.innerWidth > 940) setOpen(false); });
  })();
</script>
