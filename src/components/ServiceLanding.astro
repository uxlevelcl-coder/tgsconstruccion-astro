---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import PageHero from './PageHero.astro';
import { ICO } from '../data/iconos';
import SigueLeyendo from './SigueLeyendo.astro';
interface Tipo { t: string; d: string; ico?: string }
interface FilaPrecio { tipo: string; rango: string; incluye: string }
interface Precios { titulo: string; filas: FilaPrecio[]; nota: string }
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  lead: string;
  img: string;
  h2tipos: string;
  tipos: Tipo[];
  faq: { q: string; a: string }[];
  galeria?: { src: string; alt: string; video?: string }[];
  intro?: { h2: string; parrafos: string[]; items: string[]; pasos?: { t: string; d: string }[]; chip: string; img?: string; video?: string; poster?: string };
  precios?: Precios;
  lecturas?: { href: string; t: string; d?: string }[];
}
const { title, description, eyebrow, h1, lead, img, h2tipos, tipos, faq, galeria = [], intro, precios, lecturas = [] } = Astro.props;
const introImg = intro?.img ?? galeria[0]?.src;
const introAlt = galeria[0]?.alt ?? intro?.h2 ?? '';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={title} description={description}>
  <PageHero
    antetitulo={eyebrow}
    titulo={h1}
    bajada={lead}
    imagen={img}
    alto="md"
  >
    <div class="hero__cta">
      <a href="/contacto/" class="btn">Presupuesto sin costo</a>
      <a href={`https://wa.me/${site.empresa.whatsapp}`} class="btn btn--ghost">WhatsApp</a>
    </div>
  </PageHero>

  {intro && (
    <section class="section">
      <div class="wrap intro2">
        <div class="intro2__txt">
          <h2>{intro.h2}</h2>
          {intro.parrafos.map(p => <p>{p}</p>)}
          <ul class="checks">
            {intro.items.map(i => (
              <li>
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{i}</span>
              </li>
            ))}
          </ul>
        </div>
        <figure class="intro2__img">
          <span class="chip">{intro.chip}</span>
          {intro.video
            ? <video src={intro.video} poster={intro.poster} muted loop playsinline preload="none" data-introvideo aria-label={introAlt}></video>
            : introImg && <img src={introImg} alt={introAlt} loading="lazy" />}
        </figure>
      </div>
      {intro.pasos && (
        <div class="wrap">
          <div class="pasos">
            {intro.pasos.map((p, i) => (
              <div class="pasos__i">
                <span class="pasos__n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{p.t}</h3>
                <p>{p.d}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>
  )}
  {precios && (
    <section class="section">
      <div class="wrap">
        <div class="section-head center">
          <span class="eyebrow">Precios</span>
          <h2>{precios.titulo}</h2>
        </div>
        <div class="precios">
          <table class="precios__tabla">
            <thead>
              <tr><th scope="col">Tipo de trabajo</th><th scope="col">Valor referencial</th><th scope="col">Qué incluye</th></tr>
            </thead>
            <tbody>
              {precios.filas.map((f) => (
                <tr>
                  <th scope="row">{f.tipo}</th>
                  <td class="precios__cifra">{f.rango}</td>
                  <td class="precios__detalle">{f.incluye}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="precios__nota">{precios.nota}</p>
          <div class="precios__cta">
            <a href="/contacto/" class="btn">Pedir presupuesto exacto</a>
            <a href={`https://wa.me/${site.empresa.whatsapp}?text=${encodeURIComponent('Hola, quiero un presupuesto de remodelación.')}`} class="btn btn--ghost-dark" rel="noopener">Consultar por WhatsApp</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {galeria.length > 0 && (
    <section class="section section--obras" style="background:var(--paper-2)">
      <div class="wrap">
        <div class="section-head center">
          <span class="eyebrow">Obras</span>
          <h2>Proyectos que hemos entregado</h2>
        </div>
        <div class="gal">
          {galeria.map((g, i) => (
            <figure class={`gal__i${g.video ? ' gal__i--vid' : ''}`} data-lb={i} role="button" tabindex="0"
              aria-label={`Ampliar: ${g.alt}`}>
              {g.video
                ? <video src={g.video} poster={g.src} muted loop playsinline preload="none" data-galvideo data-lb-src={g.video} data-lb-type="video" aria-label={g.alt}></video>
                : <img src={g.src} alt={g.alt} loading="lazy" data-lb-src={g.src} data-lb-type="image" />}
              {g.video && (
                <span class="gal__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="13" height="13"><path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"/></svg>
                </span>
              )}
              <span class="gal__zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5M11 8.5v5M8.5 11h5"/></svg>
              </span>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}


  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Opciones</span>
        <h2>{h2tipos}</h2>
      </div>
      <div class="grid-serv">
        {tipos.map((t, i) => (
          <div class="serv" style="padding:26px">
            <span class="serv__ico">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor"
                   stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                   aria-hidden="true" set:html={ICO[t.ico ?? 'integral']} />
            </span>
            <h3 style="margin:8px 0 8px">{t.t}</h3>
            <p style="color:var(--ink-soft);font-size:15px;margin:0">{t.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Nuestro proceso</span>
        <h2>Cómo trabajamos</h2>
      </div>
      <div class="grid-proc">
        {[
          { t: 'Consulta y visita', d: 'Vamos a la propiedad, medimos y conversamos sobre lo que necesita.' },
          { t: 'Diseño y propuesta', d: 'Entregamos un diseño y un presupuesto detallado, sin costo.' },
          { t: 'Ejecución', d: 'Un solo equipo coordinando gasfitería, electricidad y terminaciones.' },
          { t: 'Entrega con garantía', d: 'Revisamos con usted y entregamos garantía por escrito.' },
        ].map((p, i) => (
          <div class="proc">
            <div class="proc__n">0{i + 1}</div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Lo que más nos preguntan</h2>
      </div>
      <div class="faq">
        {faq.map(f => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>


  {lecturas.length > 0 && <SigueLeyendo items={lecturas} eyebrow="Guías" titulo="Para seguir leyendo" />}

  <section class="cta">
    <div class="wrap">
      <h2>Presupuesto sin costo en 24 horas</h2>
      <p>Visitamos su propiedad, medimos y le entregamos un presupuesto detallado.</p>
      <div class="cta__btns">
        <a href={`https://wa.me/${site.empresa.whatsapp}`} class="btn btn--dark">Escribir por WhatsApp</a>
        <a href="/contacto/" class="btn" style="background:#fff">Pedir presupuesto</a>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script>
    const vids = document.querySelectorAll('video[data-introvideo]');
    if (vids.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        es.forEach(e => {
          const v = e.target;
          if (e.isIntersecting) { v.play().catch(() => {}); } else { v.pause(); }
        });
      }, { threshold: 0.35 });
      vids.forEach(v => io.observe(v));
    }

    /* los videos de la galería muestran su portada y se reproducen al pasar el mouse */
    document.querySelectorAll('video[data-galvideo]').forEach(v => {
      const fig = v.closest('.gal__i');
      const arranca = () => { v.play().catch(() => {}); };
      const para = () => { v.pause(); v.currentTime = 0; };
      fig.addEventListener('mouseenter', arranca);
      fig.addEventListener('mouseleave', para);
      fig.addEventListener('focus', arranca);
      fig.addEventListener('blur', para);
    });

    /* ---------- visor de la galería (lightbox) ---------- */
    (() => {
      const figs = [...document.querySelectorAll('.gal__i')];
      if (!figs.length) return;
      const items = figs.map(f => {
        const m = f.querySelector('[data-lb-src]');
        return { src: m.getAttribute('data-lb-src'), tipo: m.getAttribute('data-lb-type'),
                 alt: (f.querySelector('video')?.getAttribute('aria-label')) || (f.querySelector('img')?.getAttribute('alt')) || '' };
      });
      const ov = document.createElement('div');
      ov.className = 'lb';
      ov.setAttribute('role', 'dialog');
      ov.setAttribute('aria-modal', 'true');
      ov.setAttribute('aria-label', 'Galería de proyectos');
      ov.innerHTML = '<button type="button" class="lb__x" aria-label="Cerrar">Cerrar</button>' +
        '<button type="button" class="lb__nav lb__nav--prev" aria-label="Anterior"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>' +
        '<figure class="lb__fig"><div class="lb__media"></div><figcaption class="lb__cap"></figcaption></figure>' +
        '<button type="button" class="lb__nav lb__nav--next" aria-label="Siguiente"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>';
      document.body.appendChild(ov);
      const media = ov.querySelector('.lb__media');
      const cap = ov.querySelector('.lb__cap');
      let idx = 0, ultimoFoco = null;

      const pinta = () => {
        const it = items[idx];
        media.innerHTML = '';
        if (it.tipo === 'video') {
          const v = document.createElement('video');
          v.src = it.src; v.controls = true; v.autoplay = true; v.loop = true; v.playsInline = true;
          media.appendChild(v);
        } else {
          const im = document.createElement('img');
          im.src = it.src; im.alt = it.alt;
          media.appendChild(im);
        }
        cap.textContent = it.alt;
        ov.querySelectorAll('.lb__nav').forEach(n => { n.hidden = items.length < 2; });
      };
      const abre = (i, origen) => {
        idx = i; ultimoFoco = origen || null;
        pinta();
        ov.classList.add('is-open');
        document.documentElement.classList.add('lb-open');
        ov.querySelector('.lb__x').focus({ preventScroll: true });
      };
      const cierra = () => {
        ov.classList.remove('is-open');
        document.documentElement.classList.remove('lb-open');
        media.innerHTML = '';
        if (ultimoFoco) ultimoFoco.focus({ preventScroll: true });
      };
      const mueve = (d) => { idx = (idx + d + items.length) % items.length; pinta(); };

      figs.forEach((f, i) => {
        f.addEventListener('click', () => abre(i, f));
        f.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abre(i, f); }
        });
      });
      ov.querySelector('.lb__x').addEventListener('click', cierra);
      ov.querySelector('.lb__nav--prev').addEventListener('click', () => mueve(-1));
      ov.querySelector('.lb__nav--next').addEventListener('click', () => mueve(1));
      ov.addEventListener('click', (e) => { if (e.target === ov || e.target.classList.contains('lb__fig')) cierra(); });
      document.addEventListener('keydown', (e) => {
        if (!ov.classList.contains('is-open')) return;
        if (e.key === 'Escape') cierra();
        if (e.key === 'ArrowLeft') mueve(-1);
        if (e.key === 'ArrowRight') mueve(1);
      });
    })();
  </script>
</Base>
