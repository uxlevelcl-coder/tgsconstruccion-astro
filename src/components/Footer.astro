---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="wrap">
    <div class="ft__grid">
      <div>
        <div style="margin-bottom:14px">
          <img src="/img/logo-tgs-blanco.svg" alt="TGS Construcción" height="42" style="height:42px;width:auto" />
        </div>
        <p style="max-width:34ch;margin:0">{site.footer.texto}</p>
        <p style="margin:12px 0 0">
          <a href={`https://wa.me/${site.empresa.whatsapp}`} style="color:var(--gold);font-weight:500">
            WhatsApp {site.empresa.telefono}
          </a>
        </p>
      </div>

      <div class="ft__col">
        <h2>Servicios</h2>
        {site.footer.servicios.slice(0, 4).map(s => <a href={s.url}>{s.label}</a>)}
      </div>

      <div class="ft__col">
        <h2>Explorar</h2>
        <a href="/portafolio/">Portafolio</a>
        <a href="/nosotros/">Nosotros</a>
        <a href="/blog/">Blog</a>
        <a href="/contacto/">Contacto</a>
      </div>

      <div class="ft__col">
        <h2>Comunas</h2>
        <p style="margin:0;line-height:1.7">{site.empresa.comunas.join(' · ')}</p>
        <span style="color:rgba(255,254,252,.42);margin-top:2px">y toda la Región Metropolitana</span>
      </div>

      <div class="ft__col">
        <h2>Contacto</h2>
        <a href={`mailto:${site.empresa.email}`}>{site.empresa.email}</a>
        <a href={`tel:${site.empresa.telefono.replace(/\s/g, '')}`}>{site.empresa.telefono}</a>
        <span style="color:rgba(255,254,252,.42)">{site.empresa.horario}</span>
      </div>
    </div>

    <div class="ft__bottom">
      <span>© {year} {site.empresa.nombre}</span>
      <span>Santiago, Chile · uxlevel.cl</span>
    </div>
  </div>
</footer>

<a href={`https://wa.me/${site.empresa.whatsapp}?text=${encodeURIComponent('Hola, quiero un presupuesto de remodelación.')}`}
   class="wa-float" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
    <path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.2-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.1.2-.3.2-.6.1-.3-.1-1.1-.4-2.1-1.3-.8-.7-1.3-1.5-1.4-1.8-.1-.3 0-.4.1-.6.1-.1.3-.4.5-.6.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.6-1.5-.8-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.6.6.2 1.2.2 1.6.1.5-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.3-.2-.6-.4z"/>
    <path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.3c1.4.8 3 1.3 4.7 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3C4.2 15 3.8 13.5 3.8 12 3.8 7.5 7.5 3.8 12 3.8S20.2 7.5 20.2 12 16.5 20.2 12 20.2z"/>
