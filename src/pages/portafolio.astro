---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import PageHero from '../components/PageHero.astro';
import GaleriaSeccion from '../components/GaleriaSeccion.astro';

const bloques = [
  {
    eyebrow: 'Baños',
    titulo: 'Baños remodelados',
    detalle: 'Ducha a piso, vanitorio suspendido, mampara de vidrio templado e impermeabilización completa de la zona húmeda.',
    href: '/remodelacion-de-banos/',
    medios: [
      { src: '/img/bano-proyecto-1.webp', alt: 'Baño terminado con espejo redondo retroiluminado y lavamanos sobre cubierta', video: '/img/bano-proyecto-c.mp4' },
      { src: '/img/bano-proyecto-f.webp', alt: 'Baño con ducha negra, espejo LED y mueble bajo verde petróleo', video: '/img/bano-proyecto-f.mp4' },
      { src: '/img/bano-proyecto-2.webp', alt: 'Baño con ducha revestida en mosaico verde y piso hexagonal' },
      { src: '/img/bano-real-2.webp', alt: 'Baño con mampara de vidrio, vanitorio negro y espejo ovalado iluminado' },
    ],
  },
  {
    eyebrow: 'Cocinas',
    titulo: 'Cocinas remodeladas',
    detalle: 'Muebles a medida o modulares, cubierta de cuarzo, instalación de gas y electricidad declarada ante la SEC.',
    href: '/remodelacion-cocinas/',
    medios: [
      { src: '/img/cocina-terminada.jpg', alt: 'Cocina terminada con salpicadero de mármol y torre de horno empotrada', video: '/img/cocina-terminada.mp4' },
      { src: '/img/cocina-proyecto-9.webp', alt: 'Cocina con muebles gris claro sin tiradores, campana y ventanal' },
      { src: '/img/cocina-proyecto-6.webp', alt: 'Cocina con horno y microondas empotrados en mueble alto y encimera a gas' },
      { src: '/img/cocina-parque-alto.webp', alt: 'Cocina en L con muebles de madera clara y salpicadero de mármol' },
    ],
  },
  {
    eyebrow: 'Quinchos y terrazas',
    titulo: 'Quinchos y terrazas construidos',
    detalle: 'Parrilla de obra, campana, mesón de granito, estructura y cubierta. Terraza con pérgola y piscina en el mismo proyecto.',
    href: '/construccion-quinchos/',
    medios: [
      { src: '/img/quincho-proyecto-a.webp?v=3', alt: 'Quincho junto a la piscina, con pérgola e iluminación encendida de noche', video: '/img/quincho-proyecto-a.mp4?v=3' },
      { src: '/img/quincho-proyecto-b.webp?v=3', alt: 'Quincho cerrado con parrilla, campana y barra con taburetes', video: '/img/quincho-proyecto-b.mp4?v=3' },
      { src: '/img/construccion-de-quinchos-a-medida-scaled.webp', alt: 'Quincho construido en Santiago con parrilla, mesón de ladrillo y patio de pastelones' },
      { src: '/img/Terraza_1.webp', alt: 'Terraza con pérgola de madera, quincho, sofá y comedor exterior' },
    ],
  },
];
---
<Base
  title="Proyectos de Remodelación en Santiago | TGS Construcción"
  description="Baños, cocinas, quinchos y terrazas terminados. Fotos y videos de obras reales entregadas en Santiago. Presupuesto sin costo en 24 horas."
>
  <PageHero
    antetitulo="Portafolio"
    titulo="Proyectos de remodelación en Santiago"
    bajada="Obras terminadas, con fotos y videos del resultado final. Sin renders ni imágenes de catálogo."
    imagen="/img/foto_03.webp"
    alto="sm"
  />

  <section class="section">
    <div class="wrap">
      {bloques.map((b, i) => (
        <div class={i > 0 ? 'pf-bloque' : ''}>
          <div class="pf-head">
            <div>
              <span class="eyebrow">{b.eyebrow}</span>
              <h2>{b.titulo}</h2>
              <p class="pf-detalle">{b.detalle}</p>
            </div>
            <a class="pf-link" href={b.href}>
              Ver el servicio
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
            </a>
          </div>
          <GaleriaSeccion medios={b.medios} />
        </div>
      ))}
      <p class="pf-nota">Todas las imágenes corresponden a obras ejecutadas por TGS Construcción. Toque una imagen para verla completa.</p>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>¿Quiere un resultado así?</h2>
      <p>Visitamos su propiedad sin costo y le entregamos un presupuesto detallado en 24 horas.</p>
      <div class="cta__btns">
        <a href={`https://wa.me/${site.empresa.whatsapp}`} class="btn btn--dark">Escribir por WhatsApp</a>
        <a href="/contacto/" class="btn" style="background:#fff">Pedir presupuesto</a>
      </div>
    </div>
  </section>

  <style>
    .pf-bloque{margin-top:clamp(44px,6vw,72px)}
    .pf-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:22px}
    .pf-head h2{margin:6px 0 8px}
    .pf-detalle{margin:0;color:var(--ink-soft);font-size:15.5px;max-width:62ch;line-height:1.55}
    .pf-link{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:500;color:var(--gold-deep);
      text-decoration:none;white-space:nowrap;min-height:44px;border-bottom:1px solid transparent;transition:border-color .16s ease}
    .pf-link:hover{border-color:currentColor}
    .pf-nota{margin:clamp(32px,4vw,48px) 0 0;font-size:13.5px;color:var(--ink-light);text-align:center}
  </style>
</Base>
