---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import PageHero from '../components/PageHero.astro';

const pasos = [
  { n: '01', t: 'Visita y medición', d: 'Vamos a la propiedad, tomamos las medidas reales y revisamos las instalaciones existentes. Si algo no se puede hacer, se lo decimos en la misma visita, antes de que pague nada.' },
  { n: '02', t: 'Presupuesto por partida', d: 'Le entregamos el detalle separado por partidas y materiales, sin costo y en 24 horas. Usted ve cuánto cuesta cada cosa y decide con qué empezar.' },
  { n: '03', t: 'Planificación y compras', d: 'Definimos materiales, coordinamos las entregas y fijamos la fecha de inicio. No partimos sin tener claro qué se instala y cuándo llega.' },
  { n: '04', t: 'Obra con un responsable', d: 'Un maestro a cargo del proyecto y un solo teléfono para usted. Ese responsable coordina gasfitería, electricidad, cerámica, muebles y pintura, y responde por el resultado.' },
  { n: '05', t: 'Revisión y garantía', d: 'Recorremos la obra juntos, cerramos la lista de detalles y entregamos la garantía por escrito. Si algo falla después, vuelve el mismo equipo.' },
];

const oficios = [
  { t: 'Construcción general', d: 'Tabiquería, techumbre, radier y albañilería.' },
  { t: 'Pintura', d: 'Interior, exterior y textura en muros.' },
  { t: 'Acabados y revestimiento', d: 'Cerámicas, porcelanatos, pastelones, fachaleta y piedra.' },
  { t: 'Electricidad', d: 'Instalaciones residenciales, reparación de fallas y cortocircuitos.' },
  { t: 'Soldadura', d: 'Rejas, portones eléctricos y estructuras metálicas.' },
  { t: 'Gasfitería', d: 'Agua fría y caliente, instalaciones sanitarias, gas e identificación de fugas.' },
];

const especiales = ['Ampliaciones y segundo piso', 'Cobertizos y pérgolas', 'Cortavistas', 'Cocinas', 'Baños', 'Logias', 'Patios y jardines'];

const organizacion = [
  { t: 'Un responsable por proyecto', d: 'La misma persona que presupuesta responde durante la obra. No pasa de un maestro a otro.' },
  { t: 'Los oficios, coordinados por nosotros', d: 'Armamos el equipo y respondemos por el resultado final. No entregamos el proyecto completo a un tercero.' },
  { t: 'Instalaciones declaradas', d: 'Gas y electricidad se ejecutan según normativa y quedan declarados ante la SEC cuando corresponde.' },
  { t: 'Garantía por escrito', d: 'Todos los trabajos quedan con garantía conforme a la Ley del Consumidor.' },
];
---
<Base
  title="Nosotros | TGS Construcción"
  description="Equipo de remodelación en Santiago: baños, cocinas, quinchos y terrazas llave en mano. Un responsable por proyecto, presupuesto por partida y garantía por escrito."
>
  <PageHero
    antetitulo="Nosotros"
    titulo="Un equipo, un responsable, una sola conversación"
    bajada="Remodelamos baños, cocinas, quinchos y terrazas en Santiago. Cada proyecto es llave en mano: diseño, materiales, ejecución y terminaciones a cargo de un mismo equipo."
    imagen="/img/Terraza_1.webp"
    alto="sm"
  />

  <section class="section">
    <div class="wrap ns-vid">
      <div class="ns-vid__txt">
        <span class="eyebrow">Una obra entregada</span>
        <h2>Recorra un proyecto terminado</h2>
        <p class="lead">Ni renders ni fotos de catálogo. Este video es una terraza y quincho que entregamos, con el mismo equipo que va a estar en su casa.</p>
        <ul class="ns-lista">
          <li>Un solo responsable a cargo, del primer día a la entrega.</li>
          <li>Oficios coordinados: gasfitería, electricidad, cerámica, muebles y pintura.</li>
          <li>Revisión con el cliente antes de cerrar la obra.</li>
        </ul>
        <a class="btn btn--dark" href={`https://wa.me/${site.empresa.whatsapp}`}>Escribir por WhatsApp</a>
      </div>
      <figure class="ns-vid__media">
        <video
          src="/img/nosotros-obra.mp4"
          poster="/img/nosotros-obra-poster.jpg"
          controls
          playsinline
          preload="none"
          aria-label="Terraza y quincho terminados por TGS Construcción"
        ></video>
        <figcaption>Terraza y quincho terminados, con piso de porcelanato y muro de ladrillo.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Cómo trabajamos</span>
        <h2>Cinco pasos, del primer mensaje a la entrega</h2>
      </div>
      <ol class="ns-pasos">
        {pasos.map((p) => (
          <li class="ns-paso">
            <span class="ns-paso__n">{p.n}</span>
            <div>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Los oficios</span>
        <h2>Todo lo que coordinamos en una obra</h2>
        <p class="lead">No hace falta contratar un maestro por partida ni coordinar cuatro agendas distintas. El equipo cubre el proyecto completo.</p>
      </div>
      <div class="ns-oficios">
        {oficios.map((o) => (
          <div class="ns-oficio">
            <h3>{o.t}</h3>
            <p>{o.d}</p>
          </div>
        ))}
      </div>
      <div class="ns-esp">
        <h3>Proyectos especiales</h3>
        <div class="ns-chips">
          {especiales.map((e) => <span class="ns-chip">{e}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap ns-org">
      <div>
        <span class="eyebrow">Cómo nos organizamos</span>
        <h2>Cuatro compromisos que no dependen del proyecto</h2>
        <div class="ns-org__items">
          {organizacion.map((o) => (
            <div class="ns-org__i">
              <h3>{o.t}</h3>
              <p>{o.d}</p>
            </div>
          ))}
        </div>
      </div>
      <aside class="ns-card">
        <h3>Datos rápidos</h3>
        <dl>
          <div><dt>Zonas</dt><dd>{site.empresa.zonas}</dd></div>
          <div><dt>Horario</dt><dd>{site.empresa.horario}</dd></div>
          <div><dt>WhatsApp</dt><dd>{site.empresa.telefono}</dd></div>
          <div><dt>Presupuesto</dt><dd>Sin costo, en 24 horas</dd></div>
          <div><dt>Garantía</dt><dd>Por escrito en todos los trabajos</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Conversemos sobre su proyecto</h2>
      <p>Visitamos la propiedad sin costo y le entregamos un presupuesto detallado en 24 horas.</p>
      <div class="cta__btns">
        <a href={`https://wa.me/${site.empresa.whatsapp}`} class="btn btn--dark">Escribir por WhatsApp</a>
        <a href="/contacto/" class="btn" style="background:#fff">Pedir presupuesto</a>
      </div>
    </div>
  </section>

  <style>
    .ns-vid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:clamp(28px,4vw,56px);align-items:center}
    .ns-vid h2{margin:8px 0 14px}
    .ns-vid .lead{margin-bottom:20px}
    .ns-lista{list-style:none;padding:0;margin:0 0 26px;display:grid;gap:12px}
    .ns-lista li{position:relative;padding-left:24px;color:var(--body);font-size:15.5px;line-height:1.55}
    .ns-lista li::before{content:"";position:absolute;left:0;top:9px;width:8px;height:8px;border-radius:50%;background:var(--gold)}
    .ns-vid__media{margin:0;justify-self:center;width:100%;max-width:330px}
    .ns-vid__media video{width:100%;aspect-ratio:9/16;object-fit:cover;border-radius:var(--r-lg);background:#000;display:block;box-shadow:var(--sh-2)}
    .ns-vid__media figcaption{margin-top:10px;font-size:13px;color:var(--muted);line-height:1.45}

    .ns-pasos{list-style:none;margin:0;padding:0;display:grid;gap:clamp(18px,2.2vw,26px);grid-template-columns:repeat(2,minmax(0,1fr))}
    .ns-paso{display:flex;gap:16px;background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);padding:clamp(20px,2.4vw,26px)}
    .ns-paso__n{font-family:var(--mono);font-size:13px;font-weight:600;color:var(--gold-deep);letter-spacing:.04em;padding-top:3px}
    .ns-paso h3{margin:0 0 6px;font-size:17px}
    .ns-paso p{margin:0;color:var(--body);font-size:14.5px;line-height:1.6}
    .ns-paso:last-child{grid-column:1 / -1}

    .ns-oficios{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,1.8vw,20px)}
    .ns-oficio{border:1px solid var(--line);border-radius:var(--r-md);padding:20px;background:var(--white)}
    .ns-oficio h3{margin:0 0 6px;font-size:15.5px}
    .ns-oficio p{margin:0;color:var(--muted);font-size:14px;line-height:1.55}
    .ns-esp{margin-top:clamp(26px,3vw,38px);padding-top:clamp(22px,2.6vw,30px);border-top:1px solid var(--line)}
    .ns-esp h3{margin:0 0 14px;font-size:16px}
    .ns-chips{display:flex;flex-wrap:wrap;gap:9px}
    .ns-chip{font-size:13.5px;color:var(--body);background:var(--paper-2);border:1px solid var(--line);border-radius:999px;padding:8px 15px}

    .ns-org{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:clamp(28px,4vw,54px);align-items:start}
    .ns-org h2{margin:8px 0 22px}
    .ns-org__items{display:grid;gap:16px}
    .ns-org__i{border-left:2px solid var(--gold);padding-left:16px}
    .ns-org__i h3{margin:0 0 4px;font-size:15.5px}
    .ns-org__i p{margin:0;color:var(--body);font-size:14.5px;line-height:1.6}
    .ns-card{background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);padding:26px;box-shadow:var(--sh-1)}
    .ns-card h3{margin:0 0 16px;font-size:16px}
    .ns-card dl{margin:0;display:grid;gap:14px}
    .ns-card dt{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:3px}
    .ns-card dd{margin:0;font-size:14.5px;color:var(--ink);line-height:1.45}

    @media (max-width:900px){
      .ns-vid,.ns-org{grid-template-columns:minmax(0,1fr)}
      .ns-vid__media{max-width:300px;justify-self:start}
      .ns-oficios{grid-template-columns:repeat(2,minmax(0,1fr))}
    }
    @media (max-width:620px){
      .ns-pasos{grid-template-columns:minmax(0,1fr)}
      .ns-oficios{grid-template-columns:minmax(0,1fr)}
    }
  </style>
</Base>
