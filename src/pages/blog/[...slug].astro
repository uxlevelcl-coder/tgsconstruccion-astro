---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import PageHero from '../../components/PageHero.astro';
import SigueLeyendo from '../../components/SigueLeyendo.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const todos = await getCollection('posts');
const recorta = (t) => {
  const fr = (t || '').split(/(?<=\.)\s+/);
  let s = fr[0] || '';
  if (s.length < 70 && fr[1]) s += ' ' + fr[1];
  s = s.replace(/:+$/, '.');
  if (!/[.!?]$/.test(s)) s += '.';
  return s.length > 118 ? s.slice(0, 114).replace(/[\s,;]+\S*$/, '') + '…' : s;
};
const serv = post.data.servicio;
const lecturas = [
  ...(serv ? [{ href: serv.href, t: serv.t, d: 'Qué incluye el trabajo, cómo se cotiza y qué proyectos hemos entregado.', destacado: true }] : []),
  ...(post.data.relacionados ?? [])
    .map((id) => todos.find((x) => x.id === id))
    .filter(Boolean)
    .map((x) => ({ href: `/blog/${x.id}/`, t: x.data.title, d: recorta(x.data.description) })),
];
const fmt = (d) => d.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description}>
  <PageHero
    antetitulo={fmt(post.data.date)}
    titulo={post.data.title}
    bajada={post.data.description}
    imagen={post.data.image}
    alto="sm"
  />

  <article class="section">
    <div class="wrap">
      <div class="article">
        <a href="/blog/" style="color:var(--gold-deep);font-size:14px;font-weight:500;display:inline-flex;align-items:center;min-height:44px">← Volver al blog</a>
        <Content />
      </div>
    </div>
  </article>

  {lecturas.length > 0 && <SigueLeyendo items={lecturas} eyebrow="Guías" titulo="Para seguir leyendo" />}

  <section class="cta">
    <div class="wrap">
      <h2>¿Necesitas un presupuesto?</h2>
      <p>Visitamos su propiedad sin costo y le entregamos un presupuesto detallado en 24 horas.</p>
      <div class="cta__btns">
        <a href={`https://wa.me/${site.empresa.whatsapp}`} class="btn btn--dark">Escribir por WhatsApp</a>
        <a href="/contacto/" class="btn" style="background:#fff">Pedir presupuesto</a>
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('.article table').forEach((tb) => {
      if (tb.parentElement && tb.parentElement.classList.contains('tabla-scroll')) return;
      const w = document.createElement('div');
      w.className = 'tabla-scroll';
      tb.parentNode.insertBefore(w, tb);
      w.appendChild(tb);
    });
  </script>
</Base>
