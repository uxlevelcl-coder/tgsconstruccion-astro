  galeria={[
    { src: "/img/Remodelacion-de-banos_3-scaled-e1780340637473.webp", alt: "Proyecto de remodelacion de banos" },
    { src: "/img/photo-1769253523308-f7bff35c60b1-1.jpeg", alt: "Baño remodelado con bañera" },
